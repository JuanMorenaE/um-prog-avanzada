def mvnw(String args) {
    if (isUnix()) {
        sh "./mvnw -B ${args}"
    } else {
        bat "mvnw.cmd -B ${args}"
    }
}

pipeline {
    agent any

    triggers {
        pollSCM('H/2 * * * *')
    }

    stages {
        stage('Build') {
            steps {
                dir('entregable_4') { 
                    echo 'Building...'
                    script { mvnw('clean compile') } 
                }
            }
        }

        stage('Test') {
            steps {
                dir('entregable_4') {
                    echo 'Testing...'
                    script { mvnw('test') }
                }
            }
        }

        stage('Package') {
            steps {
                dir('entregable_4') {
                    echo 'Packaging...'
                    script { mvnw('package') }
                }
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, testResults: 'entregable_4/target/surefire-reports/TEST-*.xml'
        }
    }
}