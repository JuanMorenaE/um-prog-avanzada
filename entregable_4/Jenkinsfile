pipeline {
    agent any

    stages {
        stage('Build y Test') {
            steps {
                dir('entregable_4') {
                    echo 'Building and Testing...'
                    script {
                        if (isUnix()) {
                            sh './mvnw -B test'
                        } else {
                            bat 'mvnw.cmd -B test'
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, testResults: 'entregable_4/target/surefire-reports/TEST-*.xml'
        }
    }
}

